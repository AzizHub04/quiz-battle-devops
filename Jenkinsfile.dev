pipeline {
    agent any

    parameters {
        string(name: 'HOST_PORT', defaultValue: '8085', description: 'Host port to bind container')
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Install') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm install --legacy-peer-deps'
                    } else {
                        bat 'npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'docker build -t quiz-dev .'
                    } else {
                        bat 'docker build -t quiz-dev .'
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    if (isUnix()) {
                        sh "docker rm -f quiz-dev || true"
                        sh "docker run -d -p ${port}:80 --name quiz-dev quiz-dev"
                    } else {
                        bat "docker rm -f quiz-dev || exit /b 0"
                        bat "docker run -d -p ${port}:80 --name quiz-dev quiz-dev"
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    if (isUnix()) {
                        sh "export SMOKE_PORT=${port} && node smoke-test.cjs"
                    } else {
                        bat "set \"SMOKE_PORT=${port}\" && node smoke-test.cjs"
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'dist/**', allowEmptyArchive: false
            }
        }
    }

    post {
        always {
            script {
                if (isUnix()) {
                    sh 'docker rm -f quiz-dev || true'
                } else {
                    bat 'docker rm -f quiz-dev || exit /b 0'
                }
            }
        }
    }
}
