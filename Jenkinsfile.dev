pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Node Modules') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm install --legacy-peer-deps'
                    } else {
                        bat 'npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build React App') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    // ensure base image available and avoid BuildKit lease error
                    if (isUnix()) {
                        sh 'docker pull nginx:alpine || true'
                        sh 'DOCKER_BUILDKIT=0 docker build -t quiz-dev .'
                    } else {
                        bat 'docker pull nginx:alpine  || exit /b 0'
                        bat 'set "DOCKER_BUILDKIT=0" && docker build -t quiz-dev .'
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    // Remove existing container if it exists
                    if (isUnix()) {
                        sh 'docker rm -f quiz-dev || true'
                    } else {
                        bat 'docker rm -f quiz-dev || exit /b 0'
                    }

                    // Run the new container
                    if (isUnix()) {
                        sh 'docker run -d -p 8085:80 --name quiz-dev quiz-dev'
                    } else {
                        bat 'docker run -d -p 8085:80 --name quiz-dev quiz-dev'
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'node smoke-test.cjs'
                    } else {
                        bat 'node smoke-test.cjs'
                    }
                }
            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'dist/**', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            script {
                if (isUnix()) {
                    sh 'docker rm -f quiz-dev || true'
                } else {
                    bat 'docker rm -f quiz-dev || exit /b 0'
                }
            }
        }
    }
}
