pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Node Modules') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm ci --legacy-peer-deps || npm install --legacy-peer-deps'
                    } else {
                        bat 'npm ci --legacy-peer-deps || npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build React App') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'docker build -t quiz-pr .'
                    } else {
                        bat 'docker build -t quiz-pr .'
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'docker run -d -p 8085:80 --name quiz-pr quiz-pr'
                    } else {
                        bat 'docker run -d -p 8085:80 --name quiz-pr quiz-pr'
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'SMOKE_PORT=8085 node smoke-test.js'
                    } else {
                        // set environment variable for this command and run node on Windows CMD
                        bat 'set "SMOKE_PORT=8085" && node smoke-test.js'
                    }
                }
            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'build/**', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            script {
                if (isUnix()) {
                    // ignore errors if container not present
                    sh 'docker rm -f quiz-pr || true'
                } else {
                    // ensure the post step exits successfully even if container is missing
                    bat 'docker rm -f quiz-pr || exit /b 0'
                }
            }
        }
    }
}