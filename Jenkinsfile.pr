pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Node Modules') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm ci --legacy-peer-deps || npm install --legacy-peer-deps'
                    } else {
                        bat 'npm ci --legacy-peer-deps || npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build React App') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'docker build -t quiz-pr .'
                    } else {
                        bat 'docker build -t quiz-pr .'
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    // Remove existing container if it exists (safe)
                    if (isUnix()) {
                        sh 'docker rm -f quiz-pr || true'
                    } else {
                        bat 'docker rm -f quiz-pr || exit /b 0'
                    }

                    // Run the new container
                    if (isUnix()) {
                        sh 'docker run -d -p 8085:80 --name quiz-pr quiz-pr'
                    } else {
                        bat 'docker run -d -p 8085:80 --name quiz-pr quiz-pr'
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    // The repo currently uses "type":"module" so .js is treated as ESM.
                    // Preferred fix: rename smoke-test.js -> smoke-test.cjs (or convert it to ESM).
                    // Here we attempt to run smoke-test.cjs. If you haven't renamed the file,
                    // either rename it or convert it to ESM (use import).
                    if (isUnix()) {
                        sh 'node smoke-test.cjs'
                    } else {
                        bat 'node smoke-test.cjs'
                    }
                }
            }
        }

        stage('Archive Build') {
            steps {
                // Vite outputs to "dist" by default
                archiveArtifacts artifacts: 'dist/**', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            script {
                if (isUnix()) {
                    sh 'docker rm -f quiz-pr || true'
                } else {
                    bat 'docker rm -f quiz-pr || exit /b 0'
                }
            }
        }
    }
}