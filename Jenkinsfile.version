pipeline {
    agent any

    parameters {
        string(name: 'HOST_PORT', defaultValue: '8085', description: 'Host port to bind container')
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Resolve Tag') {
            steps {
                script {
                    // Find tag that points to current commit; if none, pick latest tag
                    def tag = ''
                    if (isUnix()) {
                        tag = sh(script: 'git tag --points-at HEAD | head -n1 || git describe --tags --abbrev=0', returnStdout: true).trim()
                    } else {
                        tag = bat(script: 'git tag --points-at HEAD', returnStdout: true).trim()
                        if (!tag) {
                            tag = bat(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                        }
                    }
                    if (!tag) {
                        error "No git tag found for this build. Version pipeline requires a tag (refs/tags/*)."
                    }
                    env.RELEASE_TAG = tag
                    echo "Using tag: ${env.RELEASE_TAG}"
                }
            }
        }

        stage('Install') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm install --legacy-peer-deps'
                    } else {
                        bat 'npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def img = "quiz:${env.RELEASE_TAG}"
                    if (isUnix()) {
                        sh "docker build -t ${img} ."
                    } else {
                        bat "docker build -t ${img} ."
                    }
                    env.IMAGE_NAME = img
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    def containerName = "quiz-${env.RELEASE_TAG}"
                    if (isUnix()) {
                        sh "docker rm -f ${containerName} || true"
                        sh "docker run -d -p ${port}:80 --name ${containerName} ${env.IMAGE_NAME}"
                    } else {
                        bat "docker rm -f ${containerName} || exit /b 0"
                        bat "docker run -d -p ${port}:80 --name ${containerName} ${env.IMAGE_NAME}"
                    }
                    env.CONTAINER_NAME = containerName
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    if (isUnix()) {
                        sh "export SMOKE_PORT=${port} && node smoke-test.cjs"
                    } else {
                        bat "set \"SMOKE_PORT=${port}\" && node smoke-test.cjs"
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'dist/**', allowEmptyArchive: false
            }
        }
    }

    post {
        always {
            script {
                // cleanup container from this tag build
                if (env.CONTAINER_NAME) {
                    if (isUnix()) {
                        sh "docker rm -f ${env.CONTAINER_NAME} || true"
                    } else {
                        bat "docker rm -f ${env.CONTAINER_NAME} || exit /b 0"
                    }
                } else {
                    if (isUnix()) {
                        sh "docker rm -f quiz-${env.RELEASE_TAG} || true"
                    } else {
                        bat "docker rm -f quiz-${env.RELEASE_TAG} || exit /b 0"
                    }
                }
            }
        }
    }
}
