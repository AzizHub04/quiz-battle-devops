pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Node Modules') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm install --legacy-peer-deps'
                    } else {
                        bat 'npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build React App') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    // Get the latest git tag
                    def tag = sh(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    if (isUnix()) {
                        sh "docker build -t quiz:${tag} ."
                    } else {
                        bat "docker build -t quiz:${tag} ."
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    // Remove existing container if it exists
                    if (isUnix()) {
                        sh 'docker rm -f quiz || true'
                    } else {
                        bat 'docker rm -f quiz || exit /b 0'
                    }

                    // Run the new container
                    def tag = sh(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    if (isUnix()) {
                        sh "docker run -d -p 8085:80 --name quiz quiz:${tag}"
                    } else {
                        bat "docker run -d -p 8085:80 --name quiz quiz:${tag}"
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'node smoke-test.cjs'
                    } else {
                        bat 'node smoke-test.cjs'
                    }
                }
            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'dist/**', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            script {
                if (isUnix()) {
                    sh 'docker rm -f quiz || true'
                } else {
                    bat 'docker rm -f quiz || exit /b 0'
                }
            }
        }
    }
}
