pipeline {
    agent any

    parameters {
        string(name: 'TAG', defaultValue: '', description: 'Git tag to build (e.g. v1.2.4). If empty, the tag pointing at HEAD or latest tag will be used.')
        string(name: 'HOST_PORT', defaultValue: '8085', description: 'Host port for container')
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Resolve Tag') {
            steps {
                script {
                    def chosenTag = params.TAG?.trim()
                    if (!chosenTag) {
                        if (isUnix()) {
                            chosenTag = sh(script: "git tag --points-at HEAD || git describe --tags --abbrev=0 2>/dev/null || true", returnStdout: true).trim()
                        } else {
                            chosenTag = bat(returnStdout: true, script: 'git tag --points-at HEAD 2>nul || (git describe --tags --abbrev=0 2>nul || echo)').trim()
                        }
                    }

                    if (!chosenTag) {
                        error "No git tag found for this build. Provide TAG parameter or build a tag (refs/tags/*)."
                    }

                    env.RELEASE_TAG = chosenTag
                    echo "Using tag: ${env.RELEASE_TAG}"
                }
            }
        }

        stage('Install') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm install --legacy-peer-deps'
                    } else {
                        bat 'npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def image = "quiz:${env.RELEASE_TAG}"
                    if (isUnix()) {
                        sh "docker build -t ${image} ."
                    } else {
                        bat "docker build -t ${image} ."
                    }
                    env.IMAGE_NAME = image
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    def container = "quiz-${env.RELEASE_TAG}"
                    if (isUnix()) {
                        sh "docker rm -f ${container} || true"
                        sh "docker run -d -p ${port}:80 --name ${container} ${env.IMAGE_NAME}"
                    } else {
                        bat "docker rm -f ${container} || exit /b 0"
                        bat "docker run -d -p ${port}:80 --name ${container} ${env.IMAGE_NAME}"
                    }
                    env.CONTAINER_NAME = container
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    if (isUnix()) {
                        sh "SMOKE_PORT=${port} node smoke-test.cjs"
                    } else {
                        bat "set \"SMOKE_PORT=${port}\" && node smoke-test.cjs"
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'dist/**', allowEmptyArchive: false
            }
        }
    }

    post {
        always {
            script {
                if (env.CONTAINER_NAME) {
                    if (isUnix()) {
                        sh "docker rm -f ${env.CONTAINER_NAME} || true"
                    } else {
                        bat "docker rm -f ${env.CONTAINER_NAME} || exit /b 0"
                    }
                }
            }
        }
    }
}