pipeline {
    agent any

    parameters {
        string(name: 'TAG', defaultValue: '', description: 'Git tag to build (e.g. v1.2.3). If empty, latest tag will be used.')
        string(name: 'HOST_PORT', defaultValue: '8085', description: 'Host port for container')
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    // Perform an explicit git clone/fetch that fetches tags (avoid wildcard Branch Specifier)
                    def repo = scm.userRemoteConfigs[0].url
                    if (isUnix()) {
                        sh """
                            rm -rf repo && git clone --no-tags --depth=1 ${repo} repo || true
                            cd repo
                            git fetch --tags --prune --prune-tags
                        """
                    } else {
                        bat """
                            if exist repo rmdir /s /q repo
                            git clone --no-tags --depth=1 ${repo} repo || exit /b 0
                            cd repo
                            git fetch --tags --prune --prune-tags
                        """
                    }

                    // determine tag
                    def chosenTag = params.TAG?.trim()
                    if (!chosenTag) {
                        if (isUnix()) {
                            chosenTag = sh(script: "cd repo && git describe --tags --abbrev=0", returnStdout: true).trim()
                        } else {
                            chosenTag = bat(script: "cd repo && git describe --tags --abbrev=0", returnStdout: true).trim()
                        }
                    }
                    if (!chosenTag) {
                        error "No tag found. Provide TAG parameter or push a tag (refs/tags/*)."
                    }
                    env.RELEASE_TAG = chosenTag
                    echo "Building tag: ${env.RELEASE_TAG}"
                }
            }
        }

        stage('Checkout Tag') {
            steps {
                script {
                    // checkout the chosen tag into workspace
                    if (isUnix()) {
                        sh """
                            rm -rf workspace_checkout || true
                            mkdir workspace_checkout
                            cd repo
                            git checkout ${env.RELEASE_TAG}
                            cd ..
                            rsync -a --delete repo/ workspace_checkout/ || true
                        """
                    } else {
                        bat """
                            if exist workspace_checkout rmdir /s /q workspace_checkout
                            mkdir workspace_checkout
                            cd repo
                            git checkout ${env.RELEASE_TAG}
                            cd ..
                            robocopy repo workspace_checkout /MIR
                        """
                    }
                    // Move into workspace_checkout for the rest of stages
                    dir('workspace_checkout') {
                        echo "Repository checked out at ${env.RELEASE_TAG}"
                    }
                }
            }
        }

        stage('Install') {
            steps {
                dir('workspace_checkout') {
                    script {
                        if (isUnix()) {
                            sh 'npm install --legacy-peer-deps'
                        } else {
                            bat 'npm install --legacy-peer-deps'
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('workspace_checkout') {
                    script {
                        if (isUnix()) {
                            sh 'npm run build'
                        } else {
                            bat 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('workspace_checkout') {
                    script {
                        def image = "quiz:${env.RELEASE_TAG}"
                        if (isUnix()) {
                            sh "docker build -t ${image} ."
                        } else {
                            bat "docker build -t ${image} ."
                        }
                        env.IMAGE_NAME = image
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    def container = "quiz-${env.RELEASE_TAG}"
                    if (isUnix()) {
                        sh "docker rm -f ${container} || true"
                        sh "docker run -d -p ${port}:80 --name ${container} ${env.IMAGE_NAME}"
                    } else {
                        bat "docker rm -f ${container} || exit /b 0"
                        bat "docker run -d -p ${port}:80 --name ${container} ${env.IMAGE_NAME}"
                    }
                    env.CONTAINER_NAME = container
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    def port = params.HOST_PORT ?: '8085'
                    if (isUnix()) {
                        sh "SMOKE_PORT=${port} node workspace_checkout/smoke-test.cjs"
                    } else {
                        bat "set \"SMOKE_PORT=${port}\" && node workspace_checkout\\smoke-test.cjs"
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'workspace_checkout/dist/**', allowEmptyArchive: false
            }
        }
    }

    post {
        always {
            script {
                if (env.CONTAINER_NAME) {
                    if (isUnix()) {
                        sh "docker rm -f ${env.CONTAINER_NAME} || true"
                    } else {
                        bat "docker rm -f %CONTAINER_NAME% || exit /b 0"
                    }
                }
            }
        }
    }
}